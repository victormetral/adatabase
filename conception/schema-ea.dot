digraph MCD {
graph [bgcolor=white, splines=true, overlap=false, nodesep=0.6, ranksep=1.0, fontname="Helvetica"];
node [fontname="Helvetica", fontsize=11];
edge [fontname="Helvetica-Bold", fontsize=10, color="#555555", arrowhead=none, fontcolor="#B03030"];
PERSONNE [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#2C5F9E"><TR><TD BGCOLOR="#2C5F9E"><FONT COLOR="white" FACE="Helvetica-Bold" POINT-SIZE="13">PERSONNE</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB"><U>id_personne</U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">nom</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">prenom</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">telephone</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">email</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">est_adherent</TD></TR></TABLE>>];
BENEVOLE [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#2C5F9E"><TR><TD BGCOLOR="#2C5F9E"><FONT COLOR="white" FACE="Helvetica-Bold" POINT-SIZE="13">BENEVOLE</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB"><U>id_personne</U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">date_entree</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">est_actif</TD></TR></TABLE>>];
DEPOT [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#2C5F9E"><TR><TD BGCOLOR="#2C5F9E"><FONT COLOR="white" FACE="Helvetica-Bold" POINT-SIZE="13">DEPOT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB"><U>id_depot</U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">date_depot</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">type_depot</TD></TR></TABLE>>];
OBJET [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#2C5F9E"><TR><TD BGCOLOR="#2C5F9E"><FONT COLOR="white" FACE="Helvetica-Bold" POINT-SIZE="13">OBJET</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB"><U>id_objet</U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">etiquette</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">designation</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">poids_g</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">etat_arrivee</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">statut</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">prix_affiche</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">date_mise_en_rayon</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">date_sortie_rayon</TD></TR></TABLE>>];
CATEGORIE [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#2C5F9E"><TR><TD BGCOLOR="#2C5F9E"><FONT COLOR="white" FACE="Helvetica-Bold" POINT-SIZE="13">CATEGORIE</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB"><U>id_categorie</U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">libelle</TD></TR></TABLE>>];
REPARATION [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#2C5F9E"><TR><TD BGCOLOR="#2C5F9E"><FONT COLOR="white" FACE="Helvetica-Bold" POINT-SIZE="13">REPARATION</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB"><U>id_reparation</U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">date_reparation</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">duree_heures</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">resultat</TD></TR></TABLE>>];
VENTE [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#2C5F9E"><TR><TD BGCOLOR="#2C5F9E"><FONT COLOR="white" FACE="Helvetica-Bold" POINT-SIZE="13">VENTE</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB"><U>id_vente</U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">date_vente</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">mode_paiement</TD></TR></TABLE>>];
COMPETENCE [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#2C5F9E"><TR><TD BGCOLOR="#2C5F9E"><FONT COLOR="white" FACE="Helvetica-Bold" POINT-SIZE="13">COMPETENCE</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB"><U>id_competence</U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">libelle</TD></TR></TABLE>>];
ATELIER [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#2C5F9E"><TR><TD BGCOLOR="#2C5F9E"><FONT COLOR="white" FACE="Helvetica-Bold" POINT-SIZE="13">ATELIER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB"><U>id_atelier</U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">intitule</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">date_atelier</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">duree_heures</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF2FB">nb_places</TD></TR></TABLE>>];
A_ETRE [shape=ellipse, style=filled, fillcolor="#FDF3E3", color="#C9832B", penwidth=1.6, label=<<B>EST AUSSI</B>>];
A_FAIRE [shape=ellipse, style=filled, fillcolor="#FDF3E3", color="#C9832B", penwidth=1.6, label=<<B>FAIT</B>>];
A_CONTENIR [shape=ellipse, style=filled, fillcolor="#FDF3E3", color="#C9832B", penwidth=1.6, label=<<B>CONTIENT</B>>];
A_CLASSER [shape=ellipse, style=filled, fillcolor="#FDF3E3", color="#C9832B", penwidth=1.6, label=<<B>APPARTIENT A</B>>];
A_CONCERNER [shape=ellipse, style=filled, fillcolor="#FDF3E3", color="#C9832B", penwidth=1.6, label=<<B>CONCERNE</B>>];
A_EFFECTUER [shape=ellipse, style=filled, fillcolor="#FDF3E3", color="#C9832B", penwidth=1.6, label=<<B>EFFECTUE</B>>];
A_ACHETER [shape=ellipse, style=filled, fillcolor="#FDF3E3", color="#C9832B", penwidth=1.6, label=<<B>ACHETE LORS DE</B>>];
A_COMPORTER [shape=ellipse, style=filled, fillcolor="#FDF3E3", color="#C9832B", penwidth=1.6, label=<<B>COMPORTE</B><BR/><FONT POINT-SIZE="9">prix_paye</FONT>>];
A_POSSEDER [shape=ellipse, style=filled, fillcolor="#FDF3E3", color="#C9832B", penwidth=1.6, label=<<B>POSSEDE</B>>];
A_ANIMER [shape=ellipse, style=filled, fillcolor="#FDF3E3", color="#C9832B", penwidth=1.6, label=<<B>ANIME</B>>];
A_INSCRIRE [shape=ellipse, style=filled, fillcolor="#FDF3E3", color="#C9832B", penwidth=1.6, label=<<B>S'INSCRIT A</B><BR/><FONT POINT-SIZE="9">date_inscription<BR/>est_present</FONT>>];
PERSONNE -> A_ETRE [label="0,1"];
A_ETRE -> BENEVOLE [label="1,1"];
PERSONNE -> A_FAIRE [label="0,n"];
A_FAIRE -> DEPOT [label="1,1"];
DEPOT -> A_CONTENIR [label="1,n"];
A_CONTENIR -> OBJET [label="1,1"];
OBJET -> A_CLASSER [label="1,1"];
A_CLASSER -> CATEGORIE [label="0,n"];
OBJET -> A_CONCERNER [label="0,n"];
A_CONCERNER -> REPARATION [label="1,1"];
BENEVOLE -> A_EFFECTUER [label="0,n"];
A_EFFECTUER -> REPARATION [label="1,1"];
PERSONNE -> A_ACHETER [label="0,n"];
A_ACHETER -> VENTE [label="0,1"];
VENTE -> A_COMPORTER [label="1,n"];
A_COMPORTER -> OBJET [label="0,1"];
BENEVOLE -> A_POSSEDER [label="0,n"];
A_POSSEDER -> COMPETENCE [label="0,n"];
BENEVOLE -> A_ANIMER [label="0,n"];
A_ANIMER -> ATELIER [label="1,1"];
PERSONNE -> A_INSCRIRE [label="0,n"];
A_INSCRIRE -> ATELIER [label="0,n"];
}